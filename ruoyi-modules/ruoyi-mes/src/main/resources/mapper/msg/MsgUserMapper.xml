<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.mes.msg.mapper.MsgUserMapper">


    <select id="queryUserCodePageList" resultType="org.dromara.mes.msg.domain.vo.MsgUserCodeVo">
        select id, user_name, user_code
        from mes_msg_user
        <where>
            deleted_flag = '0'
            <if test="id != null ">
                and id = #{id}
            </if>
            <if test="userName != null and userName != ''">
                and (user_name like concat('%', #{userName}, '%')
                or user_code like concat('%', #{userName}, '%'))
            </if>
        </where>
    </select>
</mapper>
